      "blocks": {
        "text_At93dB": {
          "type": "text",
          "settings": {
            "text": "<p>We welcome you to come see them the next time you stop in to the gallery. In the coming weeks I’ll be adding to this dossier with other historic material, including the spectacular figured marble fireplace surround in the front room of the first floor and some Tudor paneled doors recently installed on our fifth floor. Meanwhile, have a look at <a href=\"https://www.araderbooks.com/searchResults.php?category_id=289&action=browse&orderBy=mostrecent\"><span style=\"text-decoration:underline\">some of our books on architecture</span></a>!</p><p></p><p>J.L. Rosenberg (D.Phil, Oxon.)Head of Rare Books, Arader Galleries</p>"
          }
        }
