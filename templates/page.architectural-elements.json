        "text_EjrpQJ": {
          "type": "text",
          "settings": {
            "text": "<p>Just as the greenhouses of the XVIIc and XVIIIc gave way to the great arboreta of the XIXc, so too did the collection of decorative items, initially from the ancient world, blossom into the wholesale integration of architectural elements within domestic space.</p>"
          }
        }
      },
      "block_order": [
        "text_EjrpQJ"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "background-1",
        "full_width": true,
        "padding_top": 40,
